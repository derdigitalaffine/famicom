# Run ./scripts/bootstrap.sh; do not put production credentials in this file.
FAMICOM_DOMAIN=family.example.org
FAMICOM_WEB_DOMAIN=chat.family.example.org
FAMICOM_SIP_BIND=127.0.0.1
FAMICOM_SIP_PUBLIC_IP=auto-nat
FAMICOM_HTTPS_PORT=443
FAMICOM_HTTP_PORT=80
FAMICOM_TLS_MODE=internal
FAMICOM_FREESWITCH_IMAGE=yukiosaka/freeswitch:latest
FAMICOM_XMPP_IMAGE=prosodyim/prosody:13.0
FAMICOM_SECURE_COOKIES=true
